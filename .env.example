# ===========================================================================
# Finova Markets — environment variables (Phase 3B + Phase 3C.1)
#
# Copy this file to .env and fill in values. NEVER commit a .env file with
# real secrets. This file contains PLACEHOLDERS ONLY.
#
# Two categories:
#
#   CLIENT-SAFE      — read by the browser at build/dev time. Public values
#                      only. Anything here is visible in the frontend bundle.
#   SERVER-ONLY SECRET — read ONLY by the server runtime (the Analyst API
#                      gateway). Never expose these to the frontend, never
#                      prefix them with VITE_, never commit them.
# ===========================================================================

# ---------------------------------------------------------------------------
# CLIENT-SAFE
# ---------------------------------------------------------------------------

# Public URL of the deployed Analyst API gateway, e.g.
#   local dev:    http://localhost:8787/api/analyze
#   serverless:   https://your-fn.example.com/api/analyze
#
# When set, the Analyst UI talks to the real gateway (which owns the LLM
# credentials). When empty, the app runs the deterministic offline demo and
# never makes a network call. This variable is safe to expose: it is a public
# endpoint, not a secret.
FINOVA_ANALYST_API_URL=

# ---------------------------------------------------------------------------
# SERVER-ONLY SECRET  (Analyst API gateway runtime)
# ---------------------------------------------------------------------------

# Provider seam. Phase 3B supports the generic OpenAI-compatible seam; any
# OpenAI-compatible provider (OpenAI, DeepSeek, local models, etc.) works via
# FINOVA_LLM_BASE_URL below.
FINOVA_LLM_PROVIDER=openai-compatible

# The provider API key. SERVER-ONLY SECRET. The browser must NEVER see this.
FINOVA_LLM_API_KEY=

# Model name, e.g. gpt-4o-mini, deepseek-chat, gemini-3.6-flash, etc.
# Note: Google retires old Gemini model ids — a retired id returns a 404
# error (which the gateway reports as 502 provider-error). Use a current id.
FINOVA_LLM_MODEL=

# OpenAI-compatible base URL, e.g. https://api.openai.com/v1 or
# https://api.deepseek.com/v1 or (Gemini)
# https://generativelanguage.googleapis.com/v1beta/openai/
FINOVA_LLM_BASE_URL=

# ---------------------------------------------------------------------------
# SERVER-ONLY (optional gateway tuning — not secrets, but server-side)
# ---------------------------------------------------------------------------

# Upstream LLM call timeout in ms (default 30000).
FINOVA_LLM_TIMEOUT_MS=30000

# Local dev server port (default 8787).
FINOVA_ANALYST_PORT=8787

# Per-IP rate limit per window (default 60; 0 disables).
FINOVA_GATEWAY_RATE_LIMIT=60
FINOVA_GATEWAY_RATE_LIMIT_WINDOW_MS=60000

# CORS origin allowed to call the gateway ("*" or a single origin).
FINOVA_GATEWAY_CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# SERVER-ONLY  (Phase 3C.1 — web search evidence layer)
#
# These configure the /api/search gateway. NEVER use a VITE_ prefix on any of
# them: the browser must never see the API key or the provider selection.
# Web search is OPTIONAL — leave FINOVA_WEB_SEARCH_API_KEY empty and the
# searchWeb tool reports "not configured" honestly; the analyst still answers
# from Finova's deterministic market tools.
# ---------------------------------------------------------------------------

# Provider seam: "tavily", "brave" or "rss". Default: tavily.
#
# FREE-FIRST NOTE: "rss" uses only public, key-less RSS/Atom feeds — no paid
# API, no article scraping. It is the recommended zero-cost news source and
# keeps Tavily/Brave usage to an optional fallback. See CURATED_RSS_FEEDS in
# src/analyst/websearch/providers/rss.ts for the default endpoint list.
FINOVA_WEB_SEARCH_PROVIDER=tavily

# The provider API key. SERVER-ONLY SECRET. The browser must NEVER see this.
# Tavily: create an API key at https://tavily.com (starts with "tvly-").
# Brave Search: create an API key at https://brave.com/search/api (starts
# with "BSA").
# For provider=rss this key is NOT used and may be left empty.
FINOVA_WEB_SEARCH_API_KEY=

# RSS feed endpoint(s) when FINOVA_WEB_SEARCH_PROVIDER=rss. Comma-separated,
# no API key required. Example (a few public, legitimate financial feeds):
#   FINOVA_WEB_SEARCH_BASE_URL=https://feeds.bloomberg.com/markets/news.rss,https://www.cnbc.com/id/100003114/device/rss/rss.html,https://www.marketwatch.com/rss/topstories,https://www.investing.com/rss/news.rss,https://economictimes.indiatimes.com/rssfeeds/1977021501.cms
# Leaving this empty with provider=rss uses the curated default feed list
# exported from src/analyst/websearch/providers/rss.ts (government, central
# banks and major financial-news outlets).
FINOVA_WEB_SEARCH_BASE_URL=

# Optional override of the provider's default endpoint (e.g. a self-hosted
# Tavily-compatible service). Leave empty to use the vendor API.
FINOVA_WEB_SEARCH_BASE_URL=

# Upstream provider call timeout in ms (default 15000, clamped to 60000).
FINOVA_WEB_SEARCH_TIMEOUT_MS=15000

# Server-side response cache TTL in ms (default 300000, i.e. 5 minutes).
FINOVA_WEB_SEARCH_CACHE_TTL_MS=300000

# Server-side response cache capacity in entries (default 100, LRU).
FINOVA_WEB_SEARCH_CACHE_MAX=100